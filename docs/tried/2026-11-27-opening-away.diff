+/** How long (ms) the opening before a fight's first logged hit must be to count as an away stretch (openingWindows). */
+export const OPENING_AWAY_MS = 0;
+
+/**
+ * The fight's opening (ms): from its start to its first logged hit, when that is OPENING_AWAY_MS or more. The log
+ * records every landing that lands and records casts from the start, so a replay landing before the first logged hit
+ * found no one (the team buffing before the enemy is engaged): pending/zmdlogs-1cd1657bc305.json, Liino's battle skill
+ * pressed at 3.05 s, its projectiles and first volley at 3.43 and 5.33 s in the replay alone, the first logged hit at
+ * 11.00 s (her stance's heals came: her weapon's layers on Typhoeus and Arcane from 3.59 s). Only for the totals and
+ * the replay's enemy (enemyAwaySpans), not the away stretches' clocks (pause-holds) or presses.
+ */
+export function openingWindows(fx: Pick<LogFixture, "hits">): { readonly from: number; readonly to: number }[] {
+  const first = Math.min(...fx.hits.map((h) => h.t));
+  return Number.isFinite(first) && first >= OPENING_AWAY_MS && first > 0 ? [{ from: 0, to: first }] : [];
+}
