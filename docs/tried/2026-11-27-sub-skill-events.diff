+/**
+ * Whether a logged cast event of a fight read per target is a sub-skill's cast the log records under its skill, not a
+ * press: a logged hit of its operator at its ms (±1) has a key that is the skill's id with a suffix and that no kit hit
+ * or trigger hit lists. Camille's Vesperwings: on its target's death (buff_chr_0033_camille_normal_skill_listen_target_dead,
+ * reset_target, projhit_sub) the entity casts normal_skill_abilityrange on the next target, and ZMDLogs logs a
+ * normal_skill event at that hit's ms: 6339 at 19.68, 24.55 and 29.67 s, 7b54 at 16.59 s (four of its six such hits;
+ * none of the battle skill's own landings, which come 0.5–1.0 s after their press, is logged at it), each with her fire
+ * Susceptibility listed since that ms on the next hits, the debuff moved to the next slug. Made as presses, the replay
+ * gave each a replay-only battle-skill landing 0.4 s on (6339 20.10, 24.97, 30.07 s). Outside such fights the only such
+ * events are Purrchena's (04d4, 99fb), presses of keys her kit lacks: not read there.
+ */
+export function subSkillEvent(fx: Pick<LogFixture, "hits" | "severalTargets">, kits: readonly OperatorKit[], lc: LogCast, assume: Readonly<Record<string, string>> | undefined): boolean {
+  if (!readsTargets(fx, assume)) return false;
+  const kit = kits.find((k) => k.operator === lc.operator);
+  if (!kit) return false;
+  const known = new Set([...kit.skills.flatMap((s) => s.hits.flatMap((h) => h.events)), ...kit.triggers.flatMap((t) => allActions(t.do).flatMap((a) => (a.kind === "hits" ? a.hits.flatMap((h) => h.events) : [])))]);
+  return fx.hits.some((h) => h.operator === lc.operator && Math.abs(h.t - lc.t) <= 1 && h.event.startsWith(`${lc.skill}_`) && !known.has(h.event));
+}
+
 /** The enemy statuses whose modifiers sit on a target (engine status.ts statusModifiers' sources), by kind. */
 const STATUS_SOURCE = /^(Corrosion|Electrification|Breach) level /;
 
