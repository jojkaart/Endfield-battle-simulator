{
  "$schema": "../schemas/rules.schema.json",
  "description": "Ink Melt, hand-written (2026-11-16) from its best rotations (docs/teams/ink-melt.md): ultimates when ready, every combo when it lights up, Laevatain's battle skill in Twilight and whenever a battle skill's SP is there, Si's with SP to spare.",
  "opener": [{ "operator": "Si", "cast": "battle" }, { "operator": "Laevatain", "cast": "battle" }],
  "rules": [
    { "when": { "ultimate": "Si" }, "do": { "operator": "Si", "cast": "ultimate" } },
    { "when": { "ultimate": "Laevatain" }, "do": { "operator": "Laevatain", "cast": "ultimate" } },
    { "when": { "ultimate": "Ardelia" }, "do": { "operator": "Ardelia", "cast": "ultimate" } },
    { "when": { "ultimate": "Wulfgard" }, "do": { "operator": "Wulfgard", "cast": "ultimate" } },
    { "when": { "combo": "Laevatain" }, "do": { "operator": "Laevatain", "cast": "combo" } },
    { "when": { "combo": "Si" }, "do": { "operator": "Si", "cast": "combo" } },
    { "when": { "combo": "Wulfgard" }, "do": { "operator": "Wulfgard", "cast": "combo" } },
    { "when": { "combo": "Ardelia" }, "do": { "operator": "Ardelia", "cast": "combo" } },
    { "when": { "buff": { "operator": "Laevatain", "buff": "twilight" } }, "do": { "operator": "Laevatain", "cast": "battle" } },
    { "when": { "sp": { "atLeast": 100 } }, "do": { "operator": "Laevatain", "cast": "battle" } },
    { "when": { "sp": { "atLeast": 200 } }, "do": { "operator": "Si", "cast": "battle" } }
  ]
}
