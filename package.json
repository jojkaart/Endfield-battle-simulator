{
  "name": "endfield-battle-simulator",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:tools": "node --test tools/skport-capture/test/*.test.js",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:tools",
    "efsim": "node packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@efsim/data": "*",
    "@efsim/engine": "*",
    "@efsim/cli": "*"
  }
}
