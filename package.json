{
  "name": "endfield-battle-simulator",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:changed": "node scripts/lint-changed.ts",
    "test": "vitest run",
    "test:logs": "vitest run --config vitest.logs.config.ts",
    "test:tools": "node --test tools/skport-capture/test/*.test.js",
    "journal": "node scripts/journal.ts",
    "journal:check": "node scripts/journal.ts --check",
    "journal:new": "node scripts/journal.ts new",
    "journal:adopt": "node scripts/journal.ts adopt",
    "snapshots:update": "scripts/snapshots.sh",
    "accuracy": "node scripts/accuracy.ts --write",
    "bench": "node scripts/bench.ts",
    "merge": "node scripts/merge.ts",
    "prune-unused": "node scripts/prune-unused.ts",
    "check": "npm run journal:check && npm run typecheck && npm run lint && npm test && npm run test:logs && npm run test:tools",
    "efsim": "node packages/cli/src/main.ts",
    "setup-worktree": "node scripts/setup-worktree.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@efsim/data": "*",
    "@efsim/engine": "*",
    "@efsim/cli": "*",
    "@efsim/logs": "*"
  }
}
