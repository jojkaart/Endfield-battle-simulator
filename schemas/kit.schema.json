{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jojkaart/Endfield-battle-simulator/schemas/kit.schema.json",
  "title": "Operator kit",
  "description": "Hand-written hit structure of an operator's skills: which blackboard values multiply into each hit and how often it lands. Numbers come from the game tables; only structure is written here. Each kit lists its sources.",
  "type": "object",
  "required": ["operator", "sources", "skills"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "operator": { "type": "string" },
    "sources": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "element": { "$ref": "#/$defs/element", "description": "Default element of the operator's hits." },
    "buffs": {
      "type": "array",
      "description": "Timed buffs and debuffs the operator's hits apply (engine buffs.ts): on themselves, the team, or the enemy (acting on every team member's hits). Values come from the game data (valueSpec).",
      "items": {
        "type": "object",
        "required": ["id", "label", "target", "duration", "modifiers"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "label": { "type": "string" },
          "target": { "enum": ["self", "team", "enemy"] },
          "duration": { "$ref": "#/$defs/valueSpec", "description": "Seconds." },
          "modifiers": {
            "type": "array",
            "description": "Empty for a state that only gates skills (availableWhile).",
            "items": {
              "type": "object",
              "required": ["zone", "value"],
              "additionalProperties": false,
              "properties": {
                "zone": { "$ref": "#/$defs/zone" },
                "value": { "$ref": "#/$defs/valueSpec" },
                "elements": { "type": "array", "items": { "$ref": "#/$defs/element" }, "minItems": 1 },
                "skillType": { "$ref": "#/$defs/skillType" },
                "onlyKinds": { "type": "array", "items": { "enum": ["basic", "battle", "combo", "ultimate", "burst", "reaction", "combustionTick"] }, "minItems": 1 }
              }
            }
          },
          "note": { "type": "string" }
        }
      }
    },
    "comboTriggers": {
      "type": "array",
      "description": "What makes the combo skill castable (CharGrowthTable COMBO TRIGGER text; quote it in the note). Any listed trigger opens the window. Without this the timeline allows the combo whenever it's off cooldown.",
      "items": {
        "type": "object",
        "required": ["any"],
        "additionalProperties": false,
        "properties": {
          "any": {
            "type": "array",
            "minItems": 1,
            "items": {
              "oneOf": [
                { "type": "object", "required": ["on"], "additionalProperties": false, "properties": { "on": { "const": "reaction" }, "statuses": { "type": "array", "items": { "enum": ["combustion", "electrification", "solidification", "corrosion"] }, "minItems": 1 } } },
                { "type": "object", "required": ["on"], "additionalProperties": false, "properties": { "on": { "const": "inflictionConsumed" }, "elements": { "type": "array", "items": { "$ref": "#/$defs/artsElement" }, "minItems": 1 } } },
                { "type": "object", "required": ["on"], "additionalProperties": false, "properties": { "on": { "const": "inflictionApplied" }, "elements": { "type": "array", "items": { "$ref": "#/$defs/artsElement" }, "minItems": 1 }, "minStacks": { "type": "integer", "minimum": 1, "maximum": 4 } } },
                { "type": "object", "required": ["on"], "additionalProperties": false, "properties": { "on": { "const": "burst" }, "elements": { "type": "array", "items": { "$ref": "#/$defs/artsElement" }, "minItems": 1 } } },
                { "type": "object", "required": ["on", "stack", "atLeast"], "additionalProperties": false, "properties": { "on": { "const": "stackAtLeast" }, "stack": { "type": "string" }, "atLeast": { "type": "integer", "minimum": 1 } } }
              ]
            }
          },
          "whileBuff": { "type": "string" },
          "when": {
            "type": "object",
            "required": ["attrAtLeast"],
            "additionalProperties": false,
            "properties": { "attrAtLeast": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2 } }
          },
          "note": { "type": "string" }
        }
      }
    },
    "teamTriggers": {
      "type": "array",
      "description": "What the operator's kit does when any team member's hit of a kind lands (finalStrike: the controlled operator's Final Strikes, SkillData mask bit 2097152).",
      "items": {
        "type": "object",
        "required": ["on", "applies"],
        "additionalProperties": false,
        "properties": {
          "on": { "const": "finalStrike" },
          "applies": { "type": "array", "items": { "$ref": "#/$defs/application" } },
          "gains": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["stack"],
              "additionalProperties": false,
              "properties": { "stack": { "type": "string" }, "amount": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "const": "consumedInflictions" }] } }
            }
          },
          "note": { "type": "string" }
        }
      }
    },
    "stacks": {
      "type": "array",
      "description": "The operator's own counters (e.g. Laevatain's Melting Flame) that hits gain and require.",
      "items": {
        "type": "object",
        "required": ["id", "label", "max"],
        "additionalProperties": false,
        "properties": { "id": { "type": "string", "pattern": "^[a-z0-9_]+$" }, "label": { "type": "string" }, "max": { "type": "integer", "minimum": 1 }, "note": { "type": "string" } }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["skillId", "label", "damageType", "hits"],
        "additionalProperties": false,
        "properties": {
          "skillId": { "type": "string" },
          "label": { "type": "string" },
          "damageType": { "$ref": "#/$defs/skillType" },
          "availableWhile": { "type": "string", "description": "Castable only while this kit buff of the operator is active (e.g. enhanced attacks during the ultimate)." },
          "unavailableWhile": { "type": "string", "description": "Not castable while this kit buff of the operator is active (the plain attacks an ultimate replaces)." },
          "energyBlockSeconds": { "type": "number", "exclusiveMinimum": 0, "description": "The operator gains no ultimate energy for this long after the cast (SkillData RefrainObtainUsp buff duration)." },
          "durationFrames": { "type": "integer", "minimum": 1, "description": "How long the skill locks the operator, in 30 FPS frames (SkillData durationFrame unless the skill can be cancelled earlier; say which in a note)." },
          "note": { "type": "string" },
          "hits": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "scale"],
              "additionalProperties": false,
              "properties": {
                "id": { "type": "string" },
                "label": { "type": "string" },
                "scale": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
                "count": { "type": "integer", "minimum": 1 },
                "events": { "type": "array", "items": { "type": "string" }, "description": "Event keys battle logs (ZMDLogs) use for this hit. Default: the skill ID, when the skill has a single hit entry." },
                "frames": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "description": "Frame (30 FPS, from the skill's start) at which each landing happens; one entry per count. Projectile travel time isn't in the data, so projectile hits use the launch frame." },
                "element": { "$ref": "#/$defs/element" },
                "bonuses": {
                  "type": "array",
                  "description": "The hit's own zone bonuses from its skill's values (after potentials), e.g. a projectile's damage bonus on its first target.",
                  "items": {
                    "type": "object",
                    "required": ["zone", "key"],
                    "additionalProperties": false,
                    "properties": { "zone": { "$ref": "#/$defs/zone" }, "key": { "type": "string" } }
                  }
                },
                "factor": { "type": "number", "exclusiveMinimum": 0, "description": "Literal multiplier from the skill graph (a SimpleCalcBB × or ÷ splitting a value, e.g. 0.5 for one of two arrows); cite it in the note." },
                "reaction": {
                  "type": "object",
                  "description": "The hit's damage is an arts burst or reaction (no skill-type bonus; level coefficient and Arts Intensity apply), times its scale keys, e.g. Typhoeus's own Nature burst.",
                  "required": ["kind", "element"],
                  "additionalProperties": false,
                  "properties": { "kind": { "enum": ["burst", "reaction"] }, "element": { "$ref": "#/$defs/artsElement" }, "level": { "type": "integer", "minimum": 1, "maximum": 4 } }
                },
                "scaleIf": {
                  "type": "object",
                  "description": "An extra scale key that applies only when the enemy has an infliction of this element as the hit lands (before the hit's own applies).",
                  "required": ["key", "enemyInfliction"],
                  "additionalProperties": false,
                  "properties": { "key": { "type": "string" }, "enemyInfliction": { "$ref": "#/$defs/artsElement" } }
                },
                "when": {
                  "type": "object",
                  "description": "The hit exists only when the stat panel's attribute attrAtLeast[0] is at least attrAtLeast[1] (attribute IDs, e.g. Arcane's INT mode: Intellect ≥ Will).",
                  "required": ["attrAtLeast"],
                  "additionalProperties": false,
                  "properties": { "attrAtLeast": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2 } }
                },
                "energy": { "$ref": "#/$defs/valueSpec", "description": "Ultimate energy the operator gains when the hit lands (SkillData ObtainCostAction costType 0, e.g. a combo's usp)." },
                "buffs": {
                  "type": "array",
                  "description": "Kit buffs this hit applies when it lands; beforeDamage: the buff already acts on this hit.",
                  "items": {
                    "type": "object",
                    "required": ["buff"],
                    "additionalProperties": false,
                    "properties": { "buff": { "type": "string" }, "beforeDamage": { "type": "boolean" } }
                  }
                },
                "finalStrike": { "type": "boolean", "description": "Override: whether the hit is a Final Strike. By default read from SkillData (decorate-mask bit 2097152) via the hit's events." },
                "requires": {
                  "type": "object",
                  "description": "The hit only happens if the operator has at least this many stacks when the skill is cast; consume: all of the stack is used up by the cast.",
                  "required": ["stack", "atLeast", "consume"],
                  "additionalProperties": false,
                  "properties": { "stack": { "type": "string" }, "atLeast": { "type": "integer", "minimum": 1 }, "consume": { "type": "boolean" } }
                },
                "gains": {
                  "type": "array",
                  "description": "Stacks gained when the hit lands: a fixed amount (default 1) or the infliction stacks the hit consumed.",
                  "items": {
                    "type": "object",
                    "required": ["stack"],
                    "additionalProperties": false,
                    "properties": { "stack": { "type": "string" }, "amount": { "oneOf": [{ "type": "integer", "minimum": 1 }, { "const": "consumedInflictions" }] } }
                  }
                },
                "applies": { "type": "array", "items": { "$ref": "#/$defs/application" }, "description": "What each landing does to the enemy's arts state, in order (packages/engine/src/status.ts). Skill descriptions say which hits inflict; the game data doesn't." },
                "note": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "conditions": { "type": "array", "items": { "$ref": "#/$defs/condition" } }
  },
  "$defs": {
    "element": { "enum": ["physical", "fire", "pulse", "cryst", "natural", "ether"] },
    "valueSpec": {
      "description": "A literal, or a skill blackboard value at the applier's level after potentials (default skill: the applying hit's), optionally times a panel attribute (attribute ID) and capped by another key.",
      "oneOf": [
        { "type": "object", "required": ["literal"], "additionalProperties": false, "properties": { "literal": { "type": "number" } } },
        {
          "type": "object",
          "required": ["key"],
          "additionalProperties": false,
          "properties": {
            "key": { "type": "string" },
            "skill": { "type": "string" },
            "timesAttr": { "type": "integer", "minimum": 0 },
            "capKey": { "type": "string" },
            "scale": { "type": "number" }
          }
        }
      ]
    },
    "zone": { "enum": ["atk", "damageBonus", "amp", "susceptibility", "damageTaken", "multiplicative", "ignoreResistance", "critRate", "critDamage", "artsIntensity"] },
    "artsElement": { "enum": ["fire", "pulse", "cryst", "natural"] },
    "application": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "element"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "infliction" }, "element": { "$ref": "#/$defs/artsElement" }, "stacks": { "type": "integer", "minimum": 1, "maximum": 4 } }
        },
        {
          "type": "object",
          "required": ["kind", "status"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "forcedReaction" },
            "status": { "enum": ["combustion", "electrification", "solidification", "corrosion"] },
            "level": { "type": "integer", "minimum": 1, "maximum": 4 },
            "durationKey": { "type": "string", "description": "Skill blackboard value giving the status duration in seconds, when the skill sets it." },
            "scaleKey": { "type": "string", "description": "Skill blackboard value multiplying the status's damage over time." }
          }
        },
        {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "consumeInfliction" }, "elements": { "type": "array", "items": { "$ref": "#/$defs/artsElement" }, "minItems": 1 } }
        }
      ]
    },
    "skillType": { "enum": ["basic", "battle", "combo", "ultimate"] },
    "condition": {
      "type": "object",
      "required": ["id", "label", "source", "effect"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "label": { "type": "string" },
        "note": { "type": "string" },
        "source": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "index", "buffId", "key"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "talent" },
                "index": { "type": "integer", "minimum": 0 },
                "buffId": { "type": "string" },
                "key": { "type": "string" },
                "scale": { "type": "number" }
              }
            },
            {
              "type": "object",
              "required": ["kind", "skill", "key"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "weaponSkill" },
                "skill": { "type": "integer", "minimum": 0, "maximum": 2 },
                "key": { "type": "string" },
                "scale": { "type": "number" }
              }
            },
            {
              "type": "object",
              "description": "A value of one of the operator's own skills at the build's skill level, after potentials.",
              "required": ["kind", "skillId", "key"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "skill" },
                "skillId": { "type": "string" },
                "key": { "type": "string" },
                "scale": { "type": "number" }
              }
            }
          ]
        },
        "effect": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "attr"],
              "additionalProperties": false,
              "properties": { "kind": { "const": "attr" }, "attr": { "type": "integer", "minimum": 0 } }
            },
            {
              "type": "object",
              "required": ["kind", "zone"],
              "additionalProperties": false,
              "properties": {
                "kind": { "const": "zone" },
                "zone": { "$ref": "#/$defs/zone" },
                "element": { "$ref": "#/$defs/element" },
                "skillType": { "$ref": "#/$defs/skillType" }
              }
            }
          ]
        }
      }
    }
  }
}
