{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jojkaart/Endfield-battle-simulator/schemas/log-fixture.schema.json",
  "title": "Log fixture",
  "description": "A battle log reduced to what tests need: each operator's build and each damage hit with the buff effects the log says were active (packages/data/src/zmdlogs.ts). No player names or account IDs.",
  "type": "object",
  "required": ["id", "description", "provenance", "enemy", "team", "hits"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": { "type": "string", "pattern": "^zmdlogs-[a-z0-9]+$" },
    "description": { "type": "string" },
    "provenance": {
      "type": "object",
      "required": ["source", "url", "battleId", "parserVersion", "inGame", "measured", "verifiedAgainst", "notes"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string" },
        "url": { "type": "string" },
        "battleId": { "type": "string" },
        "parserVersion": { "type": "string" },
        "inGame": { "const": true },
        "measured": { "type": "string" },
        "verifiedAgainst": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{40}$" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "enemy": {
      "type": "object",
      "required": ["id", "level"],
      "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "level": { "type": "integer", "minimum": 1 } }
    },
    "team": { "type": "array", "items": { "$ref": "build.schema.json" }, "minItems": 1, "maxItems": 4 },
    "casts": {
      "type": "array",
      "description": "The skill events the log records without damage: a cast's start (ms) as the log has it, for skills whose casts the hits don't show (an ultimate that only buffs) or place (the kit replay corrects their start). Absent: not imported (fixtures from before 2026-10-25).",
      "items": {
        "type": "object",
        "required": ["t", "operator", "skill"],
        "additionalProperties": false,
        "properties": { "t": { "type": "number" }, "operator": { "type": "string" }, "skill": { "type": "string" } }
      }
    },
    "absent": {
      "type": "array",
      "description": "Hand-written: the replay's landings the log doesn't have and can't (a hit that didn't reach the logged enemy, or one ZMDLogs dropped), judged from the log, each with why. The totals leave each out (enginecheck.ts fightTotals): the landing of the operator's skill and hit nearest t, within 1 s.",
      "items": {
        "type": "object",
        "required": ["operator", "skillId", "hitId", "t", "why"],
        "additionalProperties": false,
        "properties": { "operator": { "type": "string" }, "skillId": { "type": "string" }, "hitId": { "type": "string" }, "t": { "type": "number" }, "why": { "type": "string" } }
      }
    },
    "hits": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["t", "operator", "event", "value", "crit", "element", "effects", "boundaryEffects", "unquantified"],
        "additionalProperties": false,
        "properties": {
          "t": { "type": "number", "description": "Milliseconds from the battle timer's start." },
          "operator": { "type": "string" },
          "target": { "type": "string", "description": "The enemy hit, in a fight against several (fixtures/multi-target only)." },
          "event": { "type": "string" },
          "value": { "type": "number" },
          "uncapped": { "type": "number" },
          "crit": { "type": ["boolean", "null"] },
          "element": { "type": ["string", "null"] },
          "effects": { "$ref": "#/$defs/effects" },
          "boundaryEffects": { "$ref": "#/$defs/effects" },
          "unquantified": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["buff", "since", "source"],
              "additionalProperties": false,
              "properties": { "buff": { "type": "string" }, "since": { "type": "number" }, "source": { "type": "string" } }
            }
          },
          "poise": {
            "type": "object",
            "description": "The Stagger the hit dealt as the log has it: dealt (positive) and the Stagger bar after it.",
            "required": ["dealt", "bar"],
            "additionalProperties": false,
            "properties": { "dealt": { "type": "number", "exclusiveMinimum": 0 }, "bar": { "type": "number", "minimum": 0 } }
          }
        }
      }
    }
  },
  "$defs": {
    "effects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["buff", "zone", "element", "value"],
        "additionalProperties": false,
        "properties": {
          "buff": { "type": "string" },
          "zone": { "enum": ["atk", "damageBonus", "amp", "susceptibility", "damageTaken", "multiplicative", "ignoreResistance", "artsIntensity"] },
          "element": { "type": ["string", "null"] },
          "value": { "type": "number" }
        }
      }
    }
  }
}
