{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": { "@efsim/engine/core": ["./packages/engine/src/core.ts"], "@efsim/*": ["./packages/*/src/index.ts"] }
  },
  "include": ["packages/*/src", "packages/*/test", "tests", "vitest.config.ts", "vitest.logs.config.ts", "vitest.shared.ts", "scripts/*.ts", "eslint.config.js"]
}
